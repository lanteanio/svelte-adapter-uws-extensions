{
  "name": "svelte-adapter-uws-extensions",
  "version": "0.6.0-next.29",
  "publishConfig": {
    "tag": "next"
  },
  "description": "Redis and Postgres extensions for svelte-adapter-uws - distributed pub/sub, replay buffers, presence tracking, rate limiting, groups, and DB change notifications",
  "author": "Kevin Radziszewski",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lanteanio/svelte-adapter-uws-extensions.git"
  },
  "homepage": "https://github.com/lanteanio/svelte-adapter-uws-extensions#readme",
  "bugs": {
    "url": "https://github.com/lanteanio/svelte-adapter-uws-extensions/issues"
  },
  "type": "module",
  "exports": {
    "./sim": {
      "types": "./src/sim.d.ts",
      "default": "./src/sim.js"
    },
    "./redis": {
      "types": "./src/redis/index.d.ts",
      "default": "./src/redis/index.js"
    },
    "./redis/pubsub": {
      "types": "./src/redis/pubsub.d.ts",
      "default": "./src/redis/pubsub.js"
    },
    "./redis/crdt": {
      "types": "./src/redis/crdt.d.ts",
      "default": "./src/redis/crdt.js"
    },
    "./redis/smooth": {
      "types": "./src/redis/smooth-cluster.d.ts",
      "default": "./src/redis/smooth-cluster.js"
    },
    "./redis/sharded-pubsub": {
      "types": "./src/redis/sharded-pubsub.d.ts",
      "default": "./src/redis/sharded-pubsub.js"
    },
    "./redis/functions": {
      "types": "./src/redis/functions.d.ts",
      "default": "./src/redis/functions.js"
    },
    "./redis/replay": {
      "types": "./src/redis/replay.d.ts",
      "default": "./src/redis/replay.js"
    },
    "./redis/presence": {
      "types": "./src/redis/presence.d.ts",
      "default": "./src/redis/presence.js"
    },
    "./postgres": {
      "types": "./src/postgres/index.d.ts",
      "default": "./src/postgres/index.js"
    },
    "./postgres/replay": {
      "types": "./src/postgres/replay.d.ts",
      "default": "./src/postgres/replay.js"
    },
    "./postgres/notify": {
      "types": "./src/postgres/notify.d.ts",
      "default": "./src/postgres/notify.js"
    },
    "./redis/ratelimit": {
      "types": "./src/redis/ratelimit.d.ts",
      "default": "./src/redis/ratelimit.js"
    },
    "./redis/upgrade-bucket": {
      "types": "./src/redis/upgrade-bucket.d.ts",
      "default": "./src/redis/upgrade-bucket.js"
