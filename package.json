    "./redis/idempotency": {
      "types": "./src/redis/idempotency.d.ts",
      "default": "./src/redis/idempotency.js"
    },
    "./redis/fence": {
      "types": "./src/redis/fence.d.ts",
      "default": "./src/redis/fence.js"
    },
    "./redis/lock": {
      "types": "./src/redis/lock.d.ts",
      "default": "./src/redis/lock.js"
    },
    "./redis/leader": {
      "types": "./src/redis/leader.d.ts",
      "default": "./src/redis/leader.js"
