	"files": [
		"src",
		"LICENSE",
		"README.md",
		"MIGRATION.md",
		"docs",
		"CHANGELOG.md"
	],
	"scripts": {
		"check": "node scripts/check-release-ledger.js && node scripts/check-compatibility.js && npm run check:documentation && node scripts/check-doc-code.js && npm run check:links && npm run check:format && npm run check:contributor-map && node scripts/generate-error-reference.js --check && node scripts/check-types.js && node scripts/check-diagnostic-attribution.js && node scripts/check-console-index.js && node scripts/check-determinism.js && node scripts/check-slugs.js && node scripts/check-vocabulary.js && node --no-warnings --experimental-vm-modules scripts/check-syntax.js && node scripts/check-release-workflow.js && npm run check:publish",
		"check:errors": "node scripts/generate-error-reference.js --check",
		"pretest": "npm run check",
		"test": "vitest run",
		"test:watch": "vitest",
		"gate:cross-repo": "node scripts/cross-repo-gate.js",
		"test:integration": "npm run test:integration:redis && npm run test:integration:postgres",
		"test:integration:redis": "vitest run --config vitest.config.integration.redis.js",
		"test:integration:postgres": "vitest run --config vitest.config.integration.postgres.js",
		"test:integration:pgbouncer": "vitest run --config vitest.config.integration.pgbouncer.js",
		"test:integration:valkey": "vitest run --config vitest.config.integration.valkey.js",
		"test:integration:cluster": "vitest run --config vitest.config.integration.cluster.js",
		"test:integration:cluster-mirror": "vitest run --config vitest.config.integration.cluster-mirror.js",
		"test:integration:valkey-cluster": "vitest run --config vitest.config.integration.valkey-cluster.js",
		"test:integration:valkey-cluster-mirror": "vitest run --config vitest.config.integration.valkey-cluster-mirror.js",
		"smoke": "node scripts/smoke.js",
		"check:format": "node scripts/check-formatting.js",
		"check:contributor-map": "node scripts/check-contributor-map.js",
		"verify:fast": "npm run check",
		"verify:docs": "npm run check:documentation && npm run check:links && npm run check:format && npm run check:contributor-map && node scripts/check-doc-code.js && node node_modules/vitest/vitest.mjs run test/contribution-tooling.test.js test/check-links.test.js test/documentation-contract.test.js test/external-links.test.js test/onboarding-contract.test.js test/onboarding-route.test.js test/doc-code-contract.test.js test/packed-readme-examples.test.js --no-cache",
		"verify:unit": "npm test -- --no-cache",
		"verify:pr": "npm run preflight && npm run verify:fast && npm run verify:unit && npm run smoke",
		"verify:redis": "npm run test:integration:redis",
		"verify:postgres": "npm run test:integration:postgres",
		"verify:valkey": "npm run test:integration:valkey",
		"verify:cluster": "npm run test:integration:cluster && npm run test:integration:cluster-mirror",
		"verify:valkey-cluster": "npm run test:integration:valkey-cluster && npm run test:integration:valkey-cluster-mirror",
		"verify:full": "npm run verify:pr && npm run verify:redis && npm run verify:postgres && npm run verify:valkey && npm run verify:cluster && npm run verify:valkey-cluster",
		"check:links": "node scripts/check-links.js",
		"check:links:external": "node scripts/check-external-links.js --concurrency=4 --timeout-ms=15000 --max-redirects=6",
		"check:documentation": "node scripts/check-documentation-contract.js",
		"preflight": "svelte-adapter-uws-preflight",
		"check:lockfile": "node scripts/check-lockfile.js",
		"verify:dependencies": "npm run check:lockfile && npm ls --all && npm audit",
		"prepublishOnly": "node scripts/check-compatibility.js --release && npm run check",
		"verify:release": "npm run verify:dependencies && npm run verify:pr && npm run test:integration",
		"check:publish": "publint && attw --pack . --profile esm-only",
		"preflight:postgres": "node scripts/check-postgres-support.js",
		"check:docs-code": "node scripts/check-doc-code.js"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"peerDependencies": {
		"svelte-adapter-uws": ">=0.6.0-next.95"
	},
	"dependencies": {
		"@types/pg": "8.23.1",
		"ioredis": "^5.10.1"
	},
	"optionalDependencies": {
		"pg": "^8.0.0"
	},
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"acorn": "^8.16.0",
		"markdown-it": "15.0.2",
		"parse5": "8.0.0",
		"publint": "^0.3.22",
		"semver": "7.7.4",
		"svelte-adapter-uws": "0.6.0-next.95",
		"typescript": "5.9.3",
		"vitest": "^4.0.18",
		"ws": "^8.0.0",
		"yaml": "2.9.0"
	},
	"overrides": {
		"cookie": "^0.7.0"
	},
	"keywords": [
		"svelte",
		"sveltekit",
		"uwebsockets",
		"redis",
		"postgres",
		"pubsub",
		"websocket",
		"presence",
		"replay",
		"ratelimit",
		"groups",
		"cursor",
		"notify",
		"prometheus",
		"metrics"
	]
}
