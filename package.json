      "types": "./src/postgres/idempotency.d.ts",
      "default": "./src/postgres/idempotency.js"
    },
    "./postgres/tasks": {
      "types": "./src/postgres/tasks.d.ts",
      "default": "./src/postgres/tasks.js"
    },
    "./postgres/jobs": {
      "types": "./src/postgres/jobs.d.ts",
      "default": "./src/postgres/jobs.js"
    },
    "./prometheus": {
      "types": "./src/prometheus/index.d.ts",
      "default": "./src/prometheus/index.js"
    },
    "./breaker": {
      "types": "./src/shared/breaker.d.ts",
      "default": "./src/shared/breaker.js"
    },
    "./assert": {
      "types": "./src/shared/assert.d.ts",
      "default": "./src/shared/assert.js"
    },
    "./admission": {
      "types": "./src/shared/admission.d.ts",
      "default": "./src/shared/admission.js"
    },
