      "types": "./src/capability-cookie.d.ts",
      "default": "./src/capability-cookie.js"
    },
    "./bus-validate": {
      "types": "./src/shared/bus-validate.d.ts",
      "default": "./src/shared/bus-validate.js"
    },
    "./sensitive": {
      "types": "./src/shared/sensitive.d.ts",
      "default": "./src/shared/sensitive.js"
    },
    "./safe-url": {
      "types": "./src/shared/safe-url.d.ts",
      "default": "./src/shared/safe-url.js"
    },
    "./testing": {
      "types": "./src/testing/index.d.ts",
      "default": "./src/testing/index.js"
    }
  },
  "files": [
    "src",
    "LICENSE",
    "README.md",
    "MIGRATION.md"
  ],
  "scripts": {
    "check": "node scripts/check-types.js && node scripts/check-determinism.js",
    "pretest": "npm run check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.config.integration.js",
    "test:integration:cluster": "vitest run --config vitest.config.integration.cluster.js",
    "test:integration:cluster-mirror": "vitest run --config vitest.config.integration.cluster-mirror.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "peerDependencies": {
    "svelte-adapter-uws": "^0.6.0-next.24"
  },
  "dependencies": {
    "ioredis": "^5.0.0"
  },
  "optionalDependencies": {
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "svelte-adapter-uws": "^0.6.0-next.24",
    "vitest": "^4.0.18",
    "ws": "^8.0.0"
  },
  "keywords": [
    "svelte",
    "sveltekit",
    "uwebsockets",
    "redis",
    "postgres",
    "pubsub",
    "websocket",
